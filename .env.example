# Copy to .env (docker compose and bin/up read it from this directory). Only the key is required.

# A dedicated OpenRouter key with a low spending limit: every agent can read it.
OPENROUTER_API_KEY=

# Optional; the defaults are shown.
# DEFAULT_MODEL=deepseek/deepseek-v4.1-flash   (OpenRouter model slug for new agents)
# NANO_CHECKOUT=../nano-checkout   (the clone of this repo mounted at /app; agents can rewrite it)
# NODE_COOKIE=                     (random, generated when the image is built)
# SYSTEM_PROMPT_FILE=priv/system_prompt.txt
# STATE_DIR=/data/state            (one file per agent, revived at boot; ./data/state on the host)
# REASONING=off                    (or minimal, low, medium, high, xhigh, max)
# AGENT_MAX_TURNS=50
# AGENT_MAX_TOKENS=3000000         (0 = no limit; likewise AGENT_MAX_TURNS and NODE_MAX_TOKENS_PER_HOUR)
# AGENT_MAX_CONTEXT=1000000        (0 = no limit)
# NODE_MAX_TOKENS_PER_HOUR=15000000
# EVAL_TIMEOUT_MS=30000
# RESULT_MAX_BYTES=16000
# MAX_BINDINGS_BYTES=16000000
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Agents are told this in their system prompt. Change it only when you change the network.
# NETWORK_POLICY=unrestricted outbound internet access
