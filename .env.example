# Copy to .env (docker compose and bin/up read it from this directory). Only the key is required,
# and only for OpenRouter models: agents on openai-codex/<model> run on a ChatGPT subscription,
# connected from the dashboard instead (see README).

# A dedicated OpenRouter key with a low spending limit: every agent can read it.
OPENROUTER_API_KEY=

# Optional; the defaults are shown.
# DEFAULT_MODEL=deepseek/deepseek-v4.1-flash   (model slug for new agents; openai-codex/gpt-6.1-sol for the subscription)
# NANO_CHECKOUT=../nano-checkout   (the clone of this repo mounted at /app; agents can rewrite it)
# NODE_COOKIE=                     (random, generated when the image is built)
# SYSTEM_PROMPT_FILE=priv/system_prompt.txt
# STATE_DIR=/data/state            (one file per agent, revived at boot; ./data/state on the host)
# REASONING=off                    (or minimal, low, medium, high, xhigh, max)
# AGENT_MAX_TURNS=500
# AGENT_MAX_TOKENS=30000000        (0 = no limit; likewise AGENT_MAX_TURNS and NODE_MAX_TOKENS_PER_HOUR)
# AGENT_MAX_CONTEXT=1000000        (0 = no limit)
# NODE_MAX_TOKENS_PER_HOUR=100000000
# EVAL_TIMEOUT_MS=30000
# RESULT_MAX_BYTES=51200
# MAX_BINDINGS_BYTES=16000000
# SPILL_DIR=/data/spill
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex
# CHATGPT_AUTH_URL=https://auth.openai.com
# CHATGPT_CLIENT_VERSION=0.160.1   (models are listed for clients this new; keep at Codex's latest release)

# Only for seedings that use them (see seedings/); the seed itself never reads these.
# EXA_API_KEY=

# Agents are told this in their system prompt. Change it only when you change the network.
# NETWORK_POLICY=unrestricted outbound internet access
