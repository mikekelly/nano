# Copy to .env (docker compose reads it from this directory).

# A dedicated git checkout of this repo, mounted at /app. Agents can rewrite anything in it.
NANO_CHECKOUT=

# A dedicated OpenRouter key with a low spending limit: every agent can read it.
OPENROUTER_API_KEY=
# OpenRouter model slug for new agents.
DEFAULT_MODEL=

# Optional; the defaults are shown.
# NODE_COOKIE=                  (random, generated when the image is built)
# AGENT_MAX_TURNS=50
# AGENT_MAX_TOKENS=500000
# NODE_MAX_TOKENS_PER_HOUR=5000000
# EVAL_TIMEOUT_MS=30000
# RESULT_MAX_BYTES=16000
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
