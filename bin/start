#!/bin/sh
# The durable net is deliberately outside the editable checkout.
if [ -f "${NANO_SAFETY_DIR:-/data/safety}/runner.py" ]; then
  exec python3 "${NANO_SAFETY_DIR:-/data/safety}/runner.py"
fi
exec elixir --name nano@127.0.0.1 --cookie "${NODE_COOKIE:-$(cat /opt/nano/cookie)}" -S mix run --no-halt
