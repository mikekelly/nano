{
  "api_version": 1,
  "authority": "named altair caller or its eval Task; generations persisted",
  "dispatch": {
    "binding": [
      "claim_token",
      "generation",
      "prepared_by",
      "resolved_unit_bytes"
    ],
    "flow": "worker ready/pull/claim; parent prepares exact compatible base and private paths before edits; submit binds dispatch generation/hash",
    "required": [
      "base_commit",
      "worktree",
      "branch",
      "build_root",
      "deps_root",
      "runtime_root",
      "random_tmp_root",
      "unit_path",
      "unit_sha256"
    ]
  },
  "docs": "docs/flywheel/u03/api.md",
  "durable_file": "state.term",
  "error_shapes": [
    ":stale",
    ":stale_owner",
    ":stale_reservation",
    ":stale_dispatch",
    ":dispatch_required",
    ":conflict",
    ":dispatch_path_conflict",
    ":degraded",
    "{:not_ready, reason}",
    "{:persistence, detail}",
    ":incompatible_base",
    ":unclaimed_diff",
    ":diff_mismatch",
    ":git_diff_failed",
    ":operation_conflict",
    ":event_conflict",
    ":missing_stages",
    ":blocked",
    ":descendant_conflict",
    ":reopen_required",
    ":invalid_evidence",
    ":resolved_unit_mismatch",
    ":unit_hash_mismatch",
    ":worktree_base_mismatch",
    ":worktree_branch_mismatch",
    ":invalid_schema",
    ":missing_dependency",
    ":cycle",
    ":duplicate_leaf_link"
  ],
  "functions": [
    "start_link/1",
    "validate/2",
    "snapshot/1",
    "unit/2",
    "readiness/2",
    "ready/1",
    "reconcile/3",
    "import/4",
    "claim/6",
    "expand/3",
    "append/4",
    "submit/3",
    "release/3",
    "adopt/4",
    "integration/4",
    "record_stage/5",
    "close/3",
    "add_units/4",
    "reopen/5",
    "resolve_external/4",
    "abandon/5",
    "prepare_dispatch/4",
    "reconcile_bootstrap/5"
  ],
  "information_format": "fixed protocol atom keys; caller evidence/extra metadata normalized to bounded strings; no artifact atom interning",
  "map_keys": "atoms",
  "module": "Nano.Flywheel",
  "reservation": [
    "unit",
    "proposal_id",
    "integration_generation",
    "owner_generation",
    "owner"
  ],
  "return": [
    "{:ok, result}",
    "{:error, reason}"
  ],
  "schema_version": 1,
  "serialization": "Erlang external term",
  "startup": "explicit parent-only, reconciliation required",
  "worker_token": [
    "unit",
    "claimant",
    "incarnation",
    "owner_generation",
    "claim_generation"
  ]
}