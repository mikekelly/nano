{
  "app": "/app",
  "backoff": 10,
  "boot_grace": 90,
  "command": [
    "/app/bin/start"
  ],
  "credentials": [
    {
      "kind": "chatgpt",
      "path": "/data/state/chatgpt_auth.json",
      "provider": "chatgpt"
    },
    {
      "keys": [
        "openrouter_api_key"
      ],
      "path": "/data/state/settings.json",
      "provider": "openrouter"
    }
  ],
  "failures": 3,
  "interval": 20,
  "max_attempts": 3,
  "probe": [
    "/opt/seed-safety/probe"
  ],
  "state": "/data/seed-safety",
  "timeout": 5
}
