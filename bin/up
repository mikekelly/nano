#!/bin/sh
# Start the sandbox, making the agents' checkout if missing, then push the settings in .env to
# the node (bin/push-settings). Needs nothing in .env: agents use OpenRouter once the node has
# its key (connected or pasted in the dashboard, or OPENROUTER_API_KEY in .env), the ChatGPT
# subscription once connected, or both.
cd "$(dirname "$0")/.." || exit 1
bin/vm >/dev/null || exit 1
export NANO_CHECKOUT="$PWD/.mounts/checkout"
export NANO_DATA="$PWD/.mounts/data"
grep -q '^OPENROUTER_API_KEY=.' .env 2>/dev/null || grep -qs '"openrouter_api_key"' .mounts/data/state/settings.json ||
  [ -f .mounts/data/state/chatgpt_auth.json ] ||
  echo "no model provider yet: connect OpenRouter or ChatGPT on the dashboard, or put OPENROUTER_API_KEY=... in .env (then bin/up again)"
checkout=$NANO_CHECKOUT
if [ ! -d "$checkout" ]; then
  mkdir -p .mounts
  revision=$(git rev-parse HEAD) || exit 1
  git clone -q --no-local --no-hardlinks . "$checkout" || exit 1
  git -C "$checkout" checkout -q -B main "$revision" || exit 1
  # The host repo is deliberately not shared with the VM.
  remote=$(git remote get-url origin) || exit 1
  git -C "$checkout" remote set-url origin "$remote" || exit 1
fi
mkdir -p "$NANO_DATA" || exit 1
bin/docker compose build --builder default || exit 1
bin/docker compose up -d --no-build || exit 1
bin/vm forward || exit 1
url="http://127.0.0.1:4000"
for i in $(seq 120); do
  curl -fsS -o /dev/null "$url/api" 2>/dev/null && { bin/push-settings "$url" .env; echo "dashboard: $url"; exit 0; }
  sleep 1
done
echo "the node has not come up; see: docker compose logs" >&2; exit 1
